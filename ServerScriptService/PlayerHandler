-- RequestUpgradeEvent (No change to signature as it doesn't involve spawning/moving monkeys or plot structures)
-- This event handler does not need to know the plotModel explicitly, as it just updates player data levels.
-- If an upgrade *involved* changing plot structures, you'd pass plotModel.
local function handlePurchaseRequest(player, monkeyTier)
	local playerData = getPlayerData(player)
	if not playerData then return end

	local plotModel = claimedPlotsFolder:FindFirstChild(playerData.CurrentPlotName or "")
	if not plotModel then warn("handlePurchaseRequest: plotModel not found for", player.Name); return end

	local plotOwner = plotModel:FindFirstChild("Owner")
	if not plotOwner or plotOwner.Value ~= tostring(player.UserId) then
		warn("handlePurchaseRequest: player does not own the plot")
		return
	end

	local spawnPoints = plotModel:FindFirstChild("PlotSpawnPoints")
	if not spawnPoints then warn("handlePurchaseRequest: No PlotSpawnPoints"); return end

	local tierConfig = MonkeyTiers:GetTier(monkeyTier)
	if not tierConfig then
		warn("handlePurchaseRequest: Invalid monkey tier")
		return
	end

	local monkeyCost = getScaledMonkeyCost(player, monkeyTier)
	if playerData.Money < monkeyCost then
		warn("handlePurchaseRequest: Can't afford monkey tier", monkeyTier, "Cost:", monkeyCost)
		return
	end
	-- Find an empty slot
	local targetSpawnPoint
	for _, spawn in pairs(spawnPoints:GetChildren()) do
		if spawn:IsA("BasePart") and not spawn:GetAttribute("HasMonkey") then
			targetSpawnPoint = spawn
			break
		end
	end

	if not targetSpawnPoint then
		warn("handlePurchaseRequest: No empty spawn point")
		return
	end

	changeMoney(player, -monkeyCost)
	targetSpawnPoint:SetAttribute("HasMonkey", true)

	local monkey = spawnMonkey(player, targetSpawnPoint.Name, targetSpawnPoint.CFrame, monkeyTier, plotModel)
	if monkey then
		playerData.MonkeySpawnSlots[targetSpawnPoint.Name] = monkeyTier
		playerData.OwnedMonkeyCounts[monkeyTier] += 1
		player:SetAttribute("Owned_" .. monkeyTier .. "_Monkeys", playerData.OwnedMonkeyCounts[monkeyTier])
		setPlayerData(player, playerData)
		autoMergeMonkeys(player, monkeyTier)
	else
		changeMoney(player, tierConfig.COST) -- Refund
		targetSpawnPoint:SetAttribute("HasMonkey", false)
		warn("handlePurchaseRequest: Failed to spawn monkey, refunded")
	end
end
local function getScaledUpgradeCost(player, upgradeName)
	local config = UpgradeConfig.Upgrades[upgradeName]
	if not config then
		warn("Upgrade config not found for:", upgradeName)
		return math.huge
	end

	local currentLevel = getPlayerData(player).Upgrades[upgradeName .. "Level"] or 0

	local baseCost = config.BaseCost or 100
	local multiplier = config.CostMultiplier or 1.5

	if typeof(baseCost) ~= "number" or typeof(multiplier) ~= "number" then
		warn("Invalid BaseCost or CostMultiplier in config for", upgradeName)
		return math.huge
	end

	return math.floor(baseCost * (multiplier ^ currentLevel))
end


local function handleUpgradeRequest(player, upgradeName)
	local playerData = getPlayerData(player)
	if not playerData then return end

	local currentLevel = playerData.Upgrades[upgradeName .. "Level"] or 0
	local nextLevel = currentLevel + 1
	local upgradeData = UpgradeConfig.Upgrades[upgradeName]
	if not upgradeData then
		warn("handleUpgradeRequest: Invalid upgrade name:", upgradeName)
		return
	end

	if upgradeData.MaxLevel and nextLevel > upgradeData.MaxLevel then
		print(player.Name .. " already has max level for " .. upgradeName)
		return
	end

	local upgradeCost = getScaledUpgradeCost(player, upgradeName)
	if playerData.Money < upgradeCost then
		print(player.Name .. " can't afford upgrade: " .. upgradeName)
		return
	end

	-- Deduct money and apply upgrade
	changeMoney(player, -upgradeCost)
	playerData.Upgrades[upgradeName .. "Level"] = nextLevel
	player:SetAttribute(upgradeName .. "Level", nextLevel)

	-- ✅ FIX: Recalculate in-session effect (for LauncherSpeed)
	if upgradeName == "LauncherSpeed" then
		playerData.Upgrades.LauncherSpeed = UpgradeConfig:GetUpgradeEffect("LauncherSpeed", nextLevel)
	end

	-- Save the updated player data
	setPlayerData(player, playerData)

	-- Fire events to update UI/buttons
	local events = game.ReplicatedStorage:WaitForChild("Events")

	local refreshPurchaseButton = events:WaitForChild("RefreshPurchaseButton")
	refreshPurchaseButton:FireClient(player, {
		Type = "Upgrade",
		Name = upgradeName,
	})

	local refreshUpgradeButton = events:WaitForChild("RefreshUpgradeButton")
	refreshUpgradeButton:FireClient(player, upgradeName)

	local updateUI = events:WaitForChild("UpdatePlayerUI")
	updateUI:FireClient(player, {
		Money = playerData.Money,
		Bananas = playerData.Bananas
	})

	print(player.Name .. " upgraded " .. upgradeName .. " to level " .. nextLevel)
end

