local Players = game:GetService("Players")
local GamepassService = require(game.ReplicatedStorage.Modules.GamepassService)
local GamepassConfig = require(game.ReplicatedStorage.Config.GamepassConfig)

local GamepassTracker = {}

local function setup(player)
    GamepassService.ApplyAttributes(player)
    if player:GetAttribute("Gamepass_"..tostring(GamepassConfig.AUTO_COLLECT)) then
        player:SetAttribute("AutoCollectActive", true)
    else
        player:SetAttribute("AutoCollectActive", false)
    end
end

Players.PlayerAdded:Connect(function(player)
    task.defer(setup, player)
end)

function GamepassTracker.SetupPlayer(player)
    setup(player)
end

function GamepassTracker.HasGamepass(player, passName)
    return GamepassService.PlayerOwns(player, passName)
end

return GamepassTracker
