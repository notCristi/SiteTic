-- --- Main Initialization for Physical Buttons (defined AFTER updateButtonVisual) ---
-- This function sets up the buttons for a *single* plot when it becomes claimed.
local function setupPlotButtons(plotModel)
	print("PhysicalButtonManager: Setting up buttons for plot: " .. plotModel.Name)

	local buyButton = plotModel:FindFirstChild("BuyTier1MonkeyButton")
	local upgradeLauncherButton = plotModel:FindFirstChild("UpgradeLauncherSpeedButton")

	if buyButton and buyButton:IsA("BasePart") then
		local surfaceGui = buyButton:WaitForChild("SurfaceGui")
		local costText = surfaceGui and surfaceGui:FindFirstChild("CostText")
		if costText and costText:IsA("TextLabel") then
			buttonConfig[buyButton] = {Type = "Purchase", Name = "Yellow", CostTextLabel = costText}
			local touchDebounce = {} -- [player] = true while debounce is active

			buyButton.Touched:Connect(function(hit)
				local character = SharedHelpers.GetCharacterFromPart(hit)
				if not character then return end
				local player = Players:GetPlayerFromCharacter(character)
				if not player or touchDebounce[player] then return end

				touchDebounce[player] = true

				-- Perform purchase
				PlayerHandler.HandlePurchaseRequest(player, "Yellow")

				-- Update only THIS button's UI
				updateButtonVisual(buyButton, player)

				task.delay(0.5, function()
					touchDebounce[player] = nil
				end)
			end)
			print("PhysicalButtonManager: Set up BuyTier1MonkeyButton for " .. plotModel.Name)
		else
			warn("PhysicalButtonManager: BuyTier1MonkeyButton in " .. plotModel.Name .. " missing SurfaceGui or CostTextLabel.")
		end
	end

	if upgradeLauncherButton and upgradeLauncherButton:IsA("BasePart") then
		local surfaceGui = upgradeLauncherButton:WaitForChild("SurfaceGui")
		local costText = surfaceGui and surfaceGui:FindFirstChild("CostText")
		if costText and costText:IsA("TextLabel") then
			buttonConfig[upgradeLauncherButton] = {Type = "Upgrade", Name = "LauncherSpeed", CostTextLabel = costText}
			upgradeLauncherButton.Touched:Connect(function(hit) onButtonTouched(upgradeLauncherButton, hit) end)
			print("PhysicalButtonManager: Set up UpgradeLauncherSpeedButton for " .. plotModel.Name)
		else
			warn("PhysicalButtonManager: UpgradeLauncherSpeedButton in " .. plotModel.Name .. " missing SurfaceGui or CostTextLabel.")
		end
	end

	-- --- Connect listener for player's money/level changes for this plot's owner ---
	local plotOwnerId = SharedHelpers.GetPlotOwnerId(plotModel)
	if plotOwnerId then
		local player = Players:GetPlayerByUserId(plotOwnerId)
		if player then
			local playerDataReplicated = player:WaitForChild("PlayerDataReplicated", 10)
			if not playerDataReplicated then warn("PhysicalButtonManager: PlayerDataReplicated not found for owner " .. player.Name .. " on plot " .. plotModel.Name); return end

			local moneyValue = player.leaderstats:WaitForChild("Money", 10)
			if not moneyValue then warn("PhysicalButtonManager: Money value not found for " .. player.Name); return end

			local upgradesFolder = playerDataReplicated:WaitForChild("Upgrades", 10)
			if not upgradesFolder then warn("PhysicalButtonManager: Upgrades folder not found for " .. player.Name); return end
			local launcherSpeedLevel = upgradesFolder:WaitForChild("LauncherSpeedLevel", 10)
			if not launcherSpeedLevel then warn("PhysicalButtonManager: LauncherSpeedLevel not found for " .. player.Name); return end

			-- Initial update for all buttons on this plot
			if buyButton then updateButtonVisual(buyButton, player) end
			if upgradeLauncherButton then updateButtonVisual(upgradeLauncherButton, player) end

			-- Listen for changes in money and upgrade levels to update button visuals
			moneyValue.Changed:Connect(function() 
				if buyButton then updateButtonVisual(buyButton, player) end
				if upgradeLauncherButton then updateButtonVisual(upgradeLauncherButton, player) end
			end)
			launcherSpeedLevel.Changed:Connect(function() 
				if buyButton then updateButtonVisual(buyButton, player) end
				if upgradeLauncherButton then updateButtonVisual(upgradeLauncherButton, player) end
			end)

		else
			warn("PhysicalButtonManager: Owner " .. plotOwnerId .. " not found (Player object) for plot " .. plotModel.Name .. ". Cannot set up dynamic button updates.")
		end
	end
end


-- --- Global Initialization (defined AFTER setupPlotButtons) ---
-- Connect to plots moving into ClaimedPlots (newly claimed or re-claimed)
local claimedPlotsFolder = workspace:WaitForChild("ClaimedPlots")
claimedPlotsFolder.ChildAdded:Connect(function(plotModel)
	if plotModel:IsA("Model") and plotModel.Name:match("^Plot%d+$") then
		task.spawn(function()
			task.wait(0.5) -- Give PlayerHandler a moment to assign Owner StringValue
			setupPlotButtons(plotModel)
		end)
	end
end)

-- Also set up buttons for any plots already in ClaimedPlots at server start (if script restarts)
for _, plotModel in pairs(claimedPlotsFolder:GetChildren()) do
	if plotModel:IsA("Model") and plotModel.Name:match("^Plot%d+$") then
		task.spawn(function()
			task.wait(0.5)
			setupPlotButtons(plotModel)
		end)
	end
end


-- --- Touched Event Handler for Buttons (defined AFTER setupPlotButtons) ---

-- --- Handle PlayerLeaving to make buttons grey (defined AFTER other functions) ---
Players.PlayerRemoving:Connect(function(leavingPlayer)
	-- Get the plot model associated with the leaving player from their PlayerDataReplicated
	local playerDataReplicated = leavingPlayer:FindFirstChild("PlayerDataReplicated")
	if not playerDataReplicated then return end

	local currentPlotNameValue = playerDataReplicated:FindFirstChild("CurrentPlotName")
	if not currentPlotNameValue or currentPlotNameValue.Value == "None" then return end

	local plotModelName = currentPlotNameValue.Value
	local plotModel = workspace:FindFirstChild("ClaimedPlots"):FindFirstChild(plotModelName)
	if not plotModel then return end

	-- Now, update all buttons on this specific plot to grey, as its owner is leaving
	for _, buttonPart in pairs(plotModel:GetDescendants()) do
		if buttonPart:IsA("BasePart") and (buttonPart.Name == "BuyTier1MonkeyButton" or buttonPart.Name == "UpgradeLauncherSpeedButton") then
			-- Set color directly to grey
			buttonPart.Color = Color3.fromRGB(150, 150, 150)
			local uiData = buttonConfig[buttonPart]
			if uiData and uiData.CostTextLabel then
				uiData.CostTextLabel.Text = uiData.CostTextLabel.Text -- Keep text, but color indicates inactivity
			end
		end
	end
end)
