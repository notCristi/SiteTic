-- --- Local Functions for Button Management (defined AFTER PlayerHandler is ready) ---
local function onButtonTouched(buttonPart, hit)
	local character = SharedHelpers.GetCharacterFromPart(hit)
	if not character then return end
	local player = Players:GetPlayerFromCharacter(character)
	if not player then return end

	local plotModel = SharedHelpers.GetPlotModelFromPart(buttonPart)
	if not plotModel then warn("Button touched but plot not found: " .. buttonPart.Name); return end

	local plotOwnerId = SharedHelpers.GetPlotOwnerId(plotModel)
	if not plotOwnerId or plotOwnerId ~= player.UserId then
		print(player.Name .. " touched " .. buttonPart.Name .. " but is not the owner of plot " .. plotModel.Name)
		return -- Only the owner can use the button
	end

	local uiData = buttonConfig[buttonPart]
	if not uiData then return end

	-- Trigger the appropriate server-side logic directly
	if uiData.Type == "Purchase" then
		PlayerHandler.HandlePurchaseRequest(player, uiData.Name)
		print(player.Name .. " requested purchase of " .. uiData.Name .. " monkey.")
	elseif uiData.Type == "Upgrade" then
		PlayerHandler.HandleUpgradeRequest(player, uiData.Name)
		print(player.Name .. " requested upgrade of " .. uiData.Name .. ".")
	end
end

