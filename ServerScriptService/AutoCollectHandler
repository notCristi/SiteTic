-- ServerScriptService/AutoCollectHandler

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local BananaCollector = require(script.Parent.BananaCollector)
local PlotUtils = require(game.ReplicatedStorage.Modules.PlotUtils)

local AutoCollectHandler = {}

-- Tracks which players have AutoCollect enabled
local activePlayers = {}

-- Radius around player to collect bananas
local COLLECTION_RADIUS = 12

function AutoCollectHandler:Activate(player)
	activePlayers[player] = true
end

function AutoCollectHandler:Deactivate(player)
	activePlayers[player] = nil
end

-- Optional: External method for scripts to query state
function AutoCollectHandler:IsEnabled(player)
	return activePlayers[player] == true
end

-- Periodic check for bananas nearby
task.spawn(function()
	while true do
		task.wait(1)
		for player, _ in pairs(activePlayers) do
			local plot = PlotUtils:GetPlayerPlot(player)
			if not plot then continue end

			for _, banana in ipairs(plot:GetDescendants()) do
				if banana:IsA("BasePart") and banana.Name == "Banana" and banana:FindFirstChild("Tier") then
					BananaCollector.ProcessBanana(player, banana)
				end
			end
		end
	end
end)



return AutoCollectHandler
