local Players = game:GetService("Players")
local MarketplaceService = game:GetService("MarketplaceService")

local GAMEPASS_ID = 1239423713  -- Replace with your actual Gamepass ID

Players.PlayerAdded:Connect(function(player)
	local success, hasPass = pcall(function()
		return MarketplaceService:UserOwnsGamePassAsync(player.UserId, GAMEPASS_ID)
	end)

	if success then
		if hasPass then
			print("GAMEPASSCHECK" .. player.Name .. " owns the gamepass: YES")
		else
			print("GAMEPASSCHECK" .. player.Name .. " owns the gamepass: NO")
		end
	else
		warn("Gamepass check failed for", player.Name)
	end
end)
