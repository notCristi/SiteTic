-- Function to get tier data by name
function MonkeyTiers:GetTier(tierName)
	return self.Tiers[tierName]
end

-- Function to get the tier name of the next tier
function MonkeyTiers:GetNextTierName(currentTierName)
	local currentTier = self:GetTier(currentTierName)
	if currentTier then
		return currentTier.NEXT_TIER_NAME
	end
	return nil
end

-- Function to get the model path for a given tier
function MonkeyTiers:GetMonkeyModelPath(tierName)
	local tier = self:GetTier(tierName)
	if tier then
		return tier.MONKEY_MODEL_PATH
	end
	return nil
end

-- Function to get the production rate for a given tier
function MonkeyTiers:GetProductionRate(tierName)
	local tier = self:GetTier(tierName)
	if tier then
		return tier.PRODUCTION_RATE
	end
	return 0
end

-- Function to get the banana model path for a given tier
function MonkeyTiers:GetBananaModelPath(tierName)
	local tier = self:GetTier(tierName)
	if tier then
		return tier.BANANA_MODEL_PATH
	end
	return nil
end

-- Function to get the reward per banana for a given tier
function MonkeyTiers:GetRewardPerBanana(tierName)
	local tier = self:GetTier(tierName)
	if tier then
		return tier.REWARD_PER_BANANA
	end
	return 0
end

-- Function to get the banana color for a given tier
function MonkeyTiers:GetBananaColor(tierName)
	local tier = self:GetTier(tierName)
	if tier then
		return tier.BANANA_COLOR
	end
	return Color3.fromRGB(255, 255, 255) -- Default white
end


return MonkeyTiers
