local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local GamepassConfig = require(game.ReplicatedStorage.Config.GamepassConfig)

local GamepassService = {}
local ownedCache = {}

-- Returns true if the player owns the gamepass specified by name
function GamepassService.PlayerOwns(player, passName)
    local passId = GamepassConfig.GetId(passName)
    if not passId then return false end

    ownedCache[passName] = ownedCache[passName] or {}
    if ownedCache[passName][player.UserId] ~= nil then
        return ownedCache[passName][player.UserId]
    end

    local success, result = pcall(MarketplaceService.UserOwnsGamePassAsync, MarketplaceService, player.UserId, passId)
    if success then
        ownedCache[passName][player.UserId] = result
        return result
    end
    return false
end

-- Preload attributes for all configured gamepasses on a player
function GamepassService.ApplyAttributes(player)
    for name, id in pairs(GamepassConfig.IDs) do
        local owns = GamepassService.PlayerOwns(player, name)
        player:SetAttribute("Gamepass_"..tostring(id), owns)
    end
end

return GamepassService
