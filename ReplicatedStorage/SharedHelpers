-- ReplicatedStorage/SharedHelpers (ModuleScript)

local SharedHelpers = {}
local MarketplaceService = game:GetService("MarketplaceService")
local function getClaimedPlotsFolder()
	local tries = 0
	while tries < 50 do -- try up to ~5 seconds
		local folder = workspace:FindFirstChild("ClaimedPlots")
		if folder then return folder end
		tries += 1
		task.wait(0.1)
	end
	warn("SharedHelpers: Timed out waiting for ClaimedPlots folder!")
	return nil
end
local claimedPlotsFolder = getClaimedPlotsFolder()


-- Replace with your actual Gamepass ID
local AUTO_COLLECT_GAMEPASS_ID = 1239423713
local Players = game:GetService("Players")

-- Helper function to find a player's character model from any of its parts
function SharedHelpers.GetCharacterFromPart(part)
	local current = part
	while current and current ~= workspace do
		if current:IsA("Model") and current:FindFirstChildOfClass("Humanoid") then
			return current
		end
		current = current.Parent
	end
	return nil
end
local function getClaimedPlotsFolder()
	local tries = 0
	while tries < 50 do -- try up to ~5 seconds
		local folder = workspace:FindFirstChild("ClaimedPlots")
		if folder then return folder end
		tries += 1
		task.wait(0.1)
	end
	warn("SharedHelpers: Timed out waiting for ClaimedPlots folder!")
	return nil
end

function SharedHelpers.GetPlotModelFromCharacter(character)
	local player = Players:GetPlayerFromCharacter(character)
	if not player then return nil end

	local replicatedData = player:FindFirstChild("PlayerDataReplicated")
	if not replicatedData then return nil end

	local currentPlotNameValue = replicatedData:FindFirstChild("CurrentPlotName")
	if not currentPlotNameValue then return nil end

	local claimedFolder = getClaimedPlotsFolder()
	if not claimedFolder then return nil end

	local plotModel = claimedFolder:FindFirstChild(currentPlotNameValue.Value)
	return plotModel
end



function SharedHelpers:PlayerHasGamepass(player, gamepassId)
	if not player or typeof(player) ~= "Instance" or not player:IsA("Player") then
		warn("PlayerHasGamepass called with invalid player:", player)
		return false
	end

	local success, hasPass = pcall(function()
		return game:GetService("MarketplaceService"):UserOwnsGamePassAsync(player.UserId, gamepassId)
	end)

	if not success then
		warn("Gamepass check failed for", player, "-", hasPass)
		return false
	end

	return hasPass
end

function SharedHelpers.GetPlayerPlot(player)
	if not player or typeof(player) ~= "Instance" or not player:IsA("Player") then
		return nil
	end

	local replicatedData = player:FindFirstChild("PlayerDataReplicated")
	if not replicatedData then return nil end

	local currentPlotNameValue = replicatedData:FindFirstChild("CurrentPlotName")
	if not currentPlotNameValue then return nil end

	local claimedFolder = getClaimedPlotsFolder()
	if not claimedFolder then return nil end

	local plotModel = claimedFolder:FindFirstChild(currentPlotNameValue.Value)
	return plotModel
end


-- Helper to get Plot Model from a descendant Part
function SharedHelpers.GetPlotModelFromPart(part)
	local current = part 
	if part.Name:match("^Plot%d+$") and part:IsA("Model") then
		-- This part IS the plot model (unlikely for a DepositZone part directly)
	else
		-- Most likely path: 'part' is a descendant of the plot, so start from its parent.
		current = part.Parent
	end

	local expectedClaimedPlotsFolder = workspace:FindFirstChild("ClaimedPlots")
	if not expectedClaimedPlotsFolder then
		-- This warn is fine, as ClaimedPlots might not exist immediately on server start or during initial PlayerHandler setup
		warn("SharedHelpers.GetPlotModelFromPart: ClaimedPlots folder NOT found in Workspace!")
		return nil
	end

	while current and current ~= workspace do
		if current.Name:match("^Plot%d+$") and current:IsA("Model") and current.Parent == expectedClaimedPlotsFolder then
			return current
		end
		current = current.Parent
	end
	return nil
end

-- Helper to get Plot Owner UserId from a PlotModel (using the "Owner" StringValue)
function SharedHelpers.GetPlotOwnerId(plotModel)
	local ownerValue = plotModel:FindFirstChild("Owner")
	if ownerValue and ownerValue:IsA("StringValue") and ownerValue.Value ~= "None" then
		return tonumber(ownerValue.Value) -- Return UserId as a number
	end
	return nil
end

return SharedHelpers
