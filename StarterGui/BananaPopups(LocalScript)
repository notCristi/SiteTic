local popupContainer = script.Parent
local template = popupContainer:WaitForChild("TemplateLabel")
local MAX_POPUPS = 11
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local popupEvent = ReplicatedStorage:WaitForChild("Events"):WaitForChild("BananaPopup")
local sound = ReplicatedStorage:WaitForChild("Sounds"):WaitForChild("BananaCollectSound")
local popupQueue = {} -- ✅ THIS is the missing table!
local activeBananaSounds = 0
local MAX_ACTIVE_SOUNDS = 5
-- Track active popups
local activePopups = {}

local function createBananaPopup(text)
	if #activePopups >= MAX_POPUPS then
		local first = table.remove(activePopups, 1)
		first:Destroy()
	end

	local clone = template:Clone()
	clone.Text = "+1🧠"
	clone.Visible = true
	clone.Parent = popupContainer

	-- Random screen position (padding to avoid edges)
	local randomX = math.random(10, 90) / 100
	local randomY = math.random(10, 80) / 100
	clone.Position = UDim2.new(randomX, 0, randomY, 0)
	clone.AnchorPoint = Vector2.new(0.5, 0.5)

	table.insert(activePopups, clone)

	-- Tween upward + fade
	local tweenInfo = TweenInfo.new(2.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	local goal = {
		Position = clone.Position - UDim2.new(0, 0, 0.05, 0),
		TextTransparency = 1,
		TextStrokeTransparency = 1
	}
	local tween = TweenService:Create(clone, tweenInfo, goal)
	tween:Play()

	-- Clean up after tween
	tween.Completed:Connect(function()
		clone:Destroy()
		table.remove(activePopups, table.find(activePopups, clone))
	end)
end


local function playBananaSound()
	if activeBananaSounds >= MAX_ACTIVE_SOUNDS then
		return -- Too many sounds playing
	end

	-- Assume you have a template sound stored somewhere (e.g., ReplicatedStorage.Sounds.BananaPickup)
	local soundTemplate = game.ReplicatedStorage:WaitForChild("Sounds"):WaitForChild("BananaCollectSound")
	local soundClone = soundTemplate:Clone()
	soundClone.Parent = workspace
	soundClone:Play()

	activeBananaSounds += 1

	-- Clean up after the sound finishes
	soundClone.Ended:Connect(function()
		activeBananaSounds -= 1
		soundClone:Destroy()
	end)

	-- Safety fallback: if Ended doesn't fire (e.g., due to errors)
	game.Debris:AddItem(soundClone, soundClone.TimeLength + 1)
end
-- Listen for remote call from server
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Events = ReplicatedStorage:WaitForChild("Events")
local BananaPopupEvent = Events:WaitForChild("BananaPopup")

BananaPopupEvent.OnClientEvent:Connect(function(amount)
	table.insert(popupQueue, amount) -- Use the actual parameter passed
	playBananaSound()
	createBananaPopup()
end)
