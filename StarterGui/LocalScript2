local player = game.Players.LocalPlayer
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local updateEvent = ReplicatedStorage:WaitForChild("Events"):WaitForChild("UpdatePlayerUI")

local gui = script.Parent
local barFrame = gui:WaitForChild("Progress Bar"):WaitForChild("Foreground"):WaitForChild("Bar")
local multiplierText = gui:WaitForChild("Progress Bar"):WaitForChild("Text"):WaitForChild("CURRENTMULTIPLIER")

-- CONFIG
local secondsPerBoost = 600 -- 10 minutes
local maxMultiplier = 2

-- TRACKER
local currentMultiplier = 1
local timeUntilNext = 0 -- how many seconds accumulated since last boost

-- UI Update Function
local function updateMultiplierDisplay()
	if currentMultiplier >= maxMultiplier then
		multiplierText.Text = string.format("CURRENT MULTIPLIER: %.2fX !MAXED!", currentMultiplier)
		barFrame:TweenSize(UDim2.new(1, 0, 1, 0), "Out", "Quad", 0.3, true)
	else
		multiplierText.Text = string.format("CURRENT MULTIPLIER: %.2fX", currentMultiplier)
		local progress = timeUntilNext / secondsPerBoost
		barFrame:TweenSize(UDim2.new(progress, 0, 1, 0), "Out", "Quad", 0.3, true)
	end
end

-- Handle UI updates from the server
updateEvent.OnClientEvent:Connect(function(uiData)
	if uiData.Multiplier then
		local oldMultiplier = currentMultiplier
		currentMultiplier = uiData.Multiplier

		if currentMultiplier > oldMultiplier then
			timeUntilNext = 0 -- reset on increase
		end
		updateMultiplierDisplay()
	end
end)

-- Simulate local timer for progress bar animation (1 sec intervals)
task.spawn(function()
	while true do
		task.wait(1)
		if currentMultiplier < maxMultiplier then
			timeUntilNext += 1
			updateMultiplierDisplay()
		end
	end
end)
