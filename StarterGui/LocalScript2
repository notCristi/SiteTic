local player = game.Players.LocalPlayer
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local updateEvent = ReplicatedStorage:WaitForChild("Events"):WaitForChild("UpdatePlayerUI")
local gamepassStatusEvent = ReplicatedStorage:WaitForChild("Events"):WaitForChild("UpdateMultiplierGamepassStatus")

local gui = script.Parent
local barFrame = gui:WaitForChild("Progress Bar"):WaitForChild("Foreground"):WaitForChild("Bar")
local multiplierText = gui:WaitForChild("Progress Bar"):WaitForChild("Text"):WaitForChild("CURRENTMULTIPLIER")

-- CONFIG
local secondsPerBoost = 600
local maxBananaMultiplier = 2

-- STATE
local bananaMultiplier = 1
local moneyMultiplierBonus = 0
local timeUntilNext = 0

-- ✅ Final combined multiplier display
local function updateMultiplierDisplay()
	local combinedMultiplier = bananaMultiplier + moneyMultiplierBonus
	multiplierText.Text = string.format("CURRENT MULTIPLIER: %.1fX", combinedMultiplier)

	local progress = math.clamp(timeUntilNext / secondsPerBoost, 0, 1)
	barFrame:TweenSize(UDim2.new(progress, 0, 1, 0), "Out", "Quad", 0.3, true)
end

-- 🟢 Server tells us how much bonus we get from Gamepass + Premium
gamepassStatusEvent.OnClientEvent:Connect(function(newMoneyBonus)
	moneyMultiplierBonus = newMoneyBonus - 1
	updateMultiplierDisplay()
end)

-- 🟢 Server tells us our session banana multiplier
updateEvent.OnClientEvent:Connect(function(uiData)
	if uiData.Multiplier then
		local old = bananaMultiplier
		bananaMultiplier = uiData.Multiplier

		if bananaMultiplier > old then
			timeUntilNext = 0
		end

		updateMultiplierDisplay()
	end
end)

-- 🔁 Animate bar
task.spawn(function()
	while true do
		task.wait(1)
		if bananaMultiplier < maxBananaMultiplier then
			timeUntilNext += 1
			updateMultiplierDisplay()
		end
	end
end)
